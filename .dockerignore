# Whitelist strategy: ignore everything, then re-include only what the web
# build needs. Anything excluded here is never copied into the image, so no
# post-copy `rm` cleanup is required in the Dockerfile.
*

!pubspec.yaml
!pubspec.lock

# Build scripts
!scripts/build-web.sh
!scripts/configure-sentry.sh
!scripts/generate-sw-manifest.sh
!scripts/prepare-web.sh
!scripts/run-sentry.sh

# Flutter web sources and assets
!lib
!lib/**
!assets
!assets/**
!web
!web/**
!configurations
!configurations/**
!server
!server/**

# Build configuration files
!l10n.yaml
!analysis_options.yaml
!config.sample.json
!.metadata

# Legacy libolm bundle (generated locally; the web build uses vodozemac)
assets/js/package/*.js
assets/js/package/*.wasm
